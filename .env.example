# 复制此文件为 .env 并修改配置

# ===== 安全配置（生产环境必填）=====
# JWT 密钥：留空则每次重启自动生成（开发用），生产环境必须固定！
# 生成方法：python -c "import secrets; print(secrets.token_urlsafe(32))"
# JWT_SECRET_KEY=your-fixed-secret-key-here
# JWT_EXPIRE_HOURS=24

# 速率限制
# RATE_LIMIT_ENABLED=True
# RATE_LIMIT_GLOBAL=120/minute
# RATE_LIMIT_LLM=20/minute
# RATE_LIMIT_AUTH=10/minute

# ===== 数据库 =====
# 默认使用 SQLite，数据库文件位于项目根目录 classvision.db
# DATABASE_URL=sqlite:///./classvision.db

# ===== Ollama 本地模型 =====
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=qwen3:4b

# ===== LLM 配置 — SiliconFlow (Qwen2.5系列) =====
# LLM_PROVIDER=siliconflow
# LLM_API_KEY=your-api-key-here
# LLM_BASE_URL=https://api.siliconflow.cn/v1
# LLM_MODEL=Qwen/Qwen2.5-14B-Instruct
# LLM_MODEL_FAST=Qwen/Qwen2.5-7B-Instruct

# ===== 火山引擎豆包（多模态/几何题/OCR备选） =====
# VOLCENGINE_API_KEY=your-api-key-here
# VOLCENGINE_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
# DOUBAO_ENDPOINT_ID=your-endpoint-id-here

# ===== 百度OCR =====
# BAIDU_OCR_API_KEY=
# BAIDU_OCR_SECRET_KEY=

# ===== RAG 配置 =====
# RAG_HYDE_ENABLED=True
# RAG_MULTI_QUERY_ENABLED=False
# RAG_RERANKER_ENABLED=True
# RAG_RERANKER_DEVICE=cpu
