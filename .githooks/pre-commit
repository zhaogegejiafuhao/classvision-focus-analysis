#!/usr/bin/env bash
# ClassVision pre-commit hook
# 防止意外提交：大文件、.env、__pycache__、数据库文件等

set -e

RED='\033[0;31m'
YELLOW='\033[1;33m'
NC='\033[0m' # No Color

has_error=0

# 获取暂存区文件列表
staged_files=$(git diff --cached --name-only --diff-filter=ACM 2>/dev/null)

if [ -z "$staged_files" ]; then
    exit 0
fi

# ─── 检查 1：禁止提交的文件类型 ─────────────────────────────
forbidden_patterns=(
    "\.env$"
    "\.env\.local$"
    "\.env\..*\.local$"
    "\.db$"
    "\.db-journal$"
    "\.db-shm$"
    "\.db-wal$"
    "\.sqlite3$"
    "\.pyc$"
    "\.pyo$"
    "\.log$"
    "\.err$"
)

for file in $staged_files; do
    for pattern in "${forbidden_patterns[@]}"; do
        if echo "$file" | grep -qE "$pattern"; then
            echo -e "${RED}❌ 禁止提交: $file${NC}"
            has_error=1
        fi
    done
done

# ─── 检查 2：__pycache__ 目录下的文件 ─────────────────────────
for file in $staged_files; do
    if echo "$file" | grep -q "__pycache__"; then
        echo -e "${RED}❌ 禁止提交 __pycache__: $file${NC}"
        has_error=1
    fi
done

# ─── 检查 3：大文件警告（>5MB）─────────────────────────────
max_size=$((5 * 1024 * 1024))  # 5MB
for file in $staged_files; do
    if [ -f "$file" ]; then
        filesize=$(wc -c < "$file" 2>/dev/null || echo 0)
        if [ "$filesize" -gt "$max_size" ]; then
            size_mb=$((filesize / 1024 / 1024))
            echo -e "${YELLOW}⚠️  大文件警告 ($${size_mb}MB): $file${NC}"
            echo -e "${YELLOW}   如果确实需要提交，请使用 Git LFS${NC}"
            has_error=1
        fi
    fi
done

# ─── 检查 4：ZhiReviewPi 目录 ────────────────────────────────
for file in $staged_files; do
    if echo "$file" | grep -q "^ZhiReviewPi/"; then
        if [ "$file" != "ZhiReviewPi/README.md" ]; then
            echo -e "${RED}❌ ZhiReviewPi 仅允许提交 README.md: $file${NC}"
            has_error=1
        fi
    fi
done

# ─── 检查 5：API 密钥泄露检测 ────────────────────────────────
for file in $staged_files; do
    if [ -f "$file" ]; then
        # 检测常见 API 密钥模式（排除 .env.example）
        if echo "$file" | grep -qv "\.env\.example"; then
            if grep -qE '(sk-[a-zA-Z0-9]{20,}|AKIA[0-9A-Z]{16}|AIza[0-9A-Za-z_-]{35}|ark-[a-f0-9-]{36})' "$file" 2>/dev/null; then
                echo -e "${RED}❌ 疑似 API 密钥泄露: $file${NC}"
                echo -e "${RED}   请检查是否误提交了密钥${NC}"
                has_error=1
            fi
        fi
    fi
done

if [ $has_error -ne 0 ]; then
    echo ""
    echo -e "${RED}🚫 提交被阻止！请修复以上问题后重新提交${NC}"
    echo -e "${YELLOW}如需强制提交，使用 git commit --no-verify${NC}"
    exit 1
fi

exit 0
